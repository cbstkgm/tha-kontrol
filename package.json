{
  "name": "tha-makam",
  "private": true,
  "version": "15.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:makam": "vite --mode makam",
    "dev:kontrol": "vite --mode kontrol",
    "build": "tsc -b && vite build",
    "build:makam": "tsc -b && vite build --mode makam --base=/tha-makam/",
    "build:kontrol": "tsc -b && vite build --mode kontrol --base=/tha-kontrol/",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "publish:all": "bash yayinla.sh"
  },
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "wellknown": "^0.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/wellknown": "^0.5.8",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
